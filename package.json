{
  "name": "sauce-demo-automation",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "playwright test --config=playwright.config.js",
    "test:chromium": "playwright test --config=playwright.config.js --project=chromium",
    "test:firefox": "playwright test --config=playwright.config.js --project=firefox",
    "test:webkit": "playwright test --config=playwright.config.js --project=webkit",
    "test:headed": "playwright test --config=playwright.config.js --headed",
    "report": "playwright show-report",
    "test:allure": "npm run test && npm run allure:generate",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  }
}
